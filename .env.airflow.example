
# Airflow metadata PostgreSQL
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Airflow security keys
AIRFLOW_FERNET_KEY=REPLACE_WITH_FERNET_KEY
AIRFLOW_API_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
AIRFLOW_JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET

# Airflow runtime
AIRFLOW_UID=50000

# Snowflake ELT connection
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=AI_TASK_MANAGEMENT_TEST_DB
SNOWFLAKE_SCHEMA=FEATURES
SNOWFLAKE_ROLE=AI_TASK_APP_ROLE
# Snowflake isolated E2E test schemas
SNOWFLAKE_RAW_SCHEMA=AIRFLOW_TEST_RAW
SNOWFLAKE_STAGING_SCHEMA=AIRFLOW_TEST_STAGING
SNOWFLAKE_ANALYTICS_SCHEMA=AIRFLOW_TEST_ANALYTICS

# Local Airflow ELT storage
ELT_DATA_DIR=/opt/airflow/test-data
